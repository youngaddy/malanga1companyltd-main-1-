rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the administrator may change content. The flag is a custom claim set
    // with the Firebase Admin API (see scripts/set-admin-claim.mjs), so it
    // cannot be obtained by registering an account with the admin email.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public listings — anyone can read, only the admin can change.
    match /properties/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage counters — public read, admin write.
    match /stats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials — public sees approved ones; anyone may submit a pending review.
    match /testimonials/{id} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if request.resource.data.approved == false
        && request.resource.data.name is string
        && request.resource.data.quote is string
        && request.resource.data.name.size() > 0
        && request.resource.data.quote.size() > 0;
      allow update, delete: if isAdmin();
    }

    // Contact / property enquiries — anyone may submit, only admin may read.
    match /messages/{id} {
      allow create: if request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone.size() > 0
        && request.resource.data.message.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
