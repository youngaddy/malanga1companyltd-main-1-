rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only the administrator may upload. See firestore.rules for how the
    // `admin` custom claim is granted.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Property photos are public; only the admin can upload or delete.
    match /malanga1/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
